<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="com.sertanfox.screamingarchitecture.presentation.viewmodels.HomePageViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        tools:context=".presentation.fragments.HomePageFragment">

        <TextView
            android:id="@+id/selectPiece"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:gravity="center"
            android:visibility="gone"
            tools:visibility="visible"
            android:text="Bir taş seçiniz"
            android:background="@color/white"
            android:textColor="@color/material_on_primary_emphasis_high_type"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/pieceSelectionLayout"
            />

        <LinearLayout
            android:id="@+id/pieceSelectionLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible"
            app:layout_constraintBottom_toTopOf="@id/chessBoard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="center"
            android:background="@color/white"
            >
            <ImageView
                android:id="@+id/selectRook"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="10dp"
                tools:src="@drawable/white_rook"
                />
            <ImageView
                android:id="@+id/selectKnight"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="10dp"
                tools:src="@drawable/white_knight"
                />
            <ImageView
                android:id="@+id/selectBishop"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="10dp"
                tools:src="@drawable/white_bishop"
                />
            <ImageView
                android:id="@+id/selectQueen"
                android:layout_width="40dp"
                android:layout_height="40dp"
                tools:src="@drawable/white_queen"
                />
        </LinearLayout>

        <GridLayout
            android:id="@+id/chessBoard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:columnCount="8"
            android:rowCount="8"
            >
        </GridLayout>

        <GridLayout
            android:id="@+id/pieces_table"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:columnCount="8"
            android:rowCount="8"
            >
        </GridLayout>

        <GridLayout
            android:id="@+id/movablesLayer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:columnCount="8"
            android:rowCount="8"
            >
        </GridLayout>


        <TextView
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="@{viewModel.welcome}" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>